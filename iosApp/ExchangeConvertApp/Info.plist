<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Only exempt encryption is used (HTTPS through Apple's networking stack). -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Required by Compose Multiplatform (high refresh rate support).
	     Merged into the generated Info.plist (GENERATE_INFOPLIST_FILE = YES). -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDisplayName</key>
	<string>Sovereign Ledger</string>
	<!-- Required for the biometric app-lock (Account → App Lock). Without
	     this iOS terminates the app the first time Face ID is invoked. -->
	<key>NSFaceIDUsageDescription</key>
	<string>Unlock your ledger with Face ID.</string>
	<!-- Rate alerts (local notifications): the background refresh task
	     fetching fresh rates and posting local notifications. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>dali.hamza.shared.ratealerts</string>
	</array>
</dict>
</plist>
