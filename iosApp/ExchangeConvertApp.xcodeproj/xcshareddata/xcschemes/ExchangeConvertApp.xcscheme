<?xml version="1.0" encoding="UTF-8"?>
<Scheme
   version = "1.3">
   <BuildAction>
      <PreActions>
         <ExecutionAction
            ActionType = "Xcode.IDEStandardExecutionActionsCore.ExecutionActionType.ShellScriptAction">
            <ActionContent
               title = "Build Kotlin Framework"
               scriptText = "cd &quot;$SRCROOT/..&quot;&#10;if [ &quot;YES&quot; = &quot;$OVERRIDE_KOTLIN_BUILD_IDE_SUPPORTED&quot; ]; then&#10;    echo &quot;Skipping Gradle build task invocation due to OVERRIDE_KOTLIN_BUILD_IDE_SUPPORTED environment variable set to \&quot;YES\&quot;&quot;&#10;    exit 0&#10;fi&#10;if [ &quot;$ASC_FW_CACHE_HIT&quot; = &quot;true&quot; ]; then&#10;    FW=$(ls -d shared/build/xcode-frameworks/&quot;$CONFIGURATION&quot;/*/shared.framework 2&gt;/dev/null | head -n 1)&#10;    OK=&quot;&quot;&#10;    if [ -n &quot;$FW&quot; ] &amp;&amp; [ -n &quot;$TARGET_BUILD_DIR&quot; ]; then&#10;        DESTS=&quot;$TARGET_BUILD_DIR&quot;&#10;        case &quot;$TARGET_BUILD_DIR&quot; in&#10;            */InstallationBuildProductsLocation/Applications)&#10;                # archive builds: Swift resolves modules from the sibling&#10;                # BuildProductsPath dir, not the install location&#10;                DESTS=&quot;$DESTS ${TARGET_BUILD_DIR%/InstallationBuildProductsLocation/Applications}/BuildProductsPath/$CONFIGURATION-$PLATFORM_NAME&quot;&#10;                ;;&#10;        esac&#10;        OK=1&#10;        for d in $DESTS; do&#10;            mkdir -p &quot;$d&quot; &amp;&amp; cp -R &quot;$FW&quot; &quot;$d/&quot; || OK=&quot;&quot;&#10;        done&#10;        if [ -n &quot;$OK&quot; ]; then&#10;            echo &quot;shared.framework restored from CI cache: $FW&quot;&#10;            exit 0&#10;        fi&#10;    fi&#10;    echo &quot;CI cache restore incomplete - building via Gradle&quot;&#10;fi&#10;./gradlew :shared:embedAndSignAppleFrameworkForXcode&#10;">
               <EnvironmentBuildable>
                  <BuildableReference
                     BuildableIdentifier = "primary"
                     BlueprintIdentifier = "A6000001"
                     BuildableName = "ExchangeConvertApp.app"
                     BlueprintName = "ExchangeConvertApp"
                     ReferencedContainer = "container:ExchangeConvertApp.xcodeproj">
                  </BuildableReference>
               </EnvironmentBuildable>
            </ActionContent>
         </ExecutionAction>
      </PreActions>
      <BuildActionEntries>
         <BuildActionEntry
            buildForRunning = "YES">
            <BuildableReference
               BuildableIdentifier = "primary"
               BlueprintIdentifier = "A6000001"
               BuildableName = "ExchangeConvertApp.app"
               BlueprintName = "ExchangeConvertApp"
               ReferencedContainer = "container:ExchangeConvertApp.xcodeproj">
            </BuildableReference>
         </BuildActionEntry>
      </BuildActionEntries>
   </BuildAction>
   <LaunchAction
      useCustomWorkingDirectory = "NO"
      buildConfiguration = "Debug"
      allowLocationSimulation = "YES">
      <BuildableProductRunnable>
         <BuildableReference
            BuildableIdentifier = "primary"
            BlueprintIdentifier = "A6000001"
            BuildableName = "ExchangeConvertApp.app"
            BlueprintName = "ExchangeConvertApp"
            ReferencedContainer = "container:ExchangeConvertApp.xcodeproj">
         </BuildableReference>
      </BuildableProductRunnable>
      <LocationScenarioReference
         identifier = "com.apple.dt.IDEFoundation.CurrentLocationScenarioIdentifier"
         referenceType = "1">
      </LocationScenarioReference>
   </LaunchAction>
</Scheme>
