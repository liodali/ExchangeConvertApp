<?xml version="1.0" encoding="utf-8"?>
<!-- A small red disc with a white beetle — the classic "debug build" badge. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="28dp"
    android:height="28dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- red disc -->
    <path
        android:fillColor="#E53935"
        android:pathData="M12,2 a10,10 0 1,0 0.001,0 z"/>

    <!-- bug: head + body -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12,6.2 a1.8,1.8 0 1,0 0.001,0 z"/>
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12,9.2 c2.9,0 4.6,2.3 4.6,5.3 0,3.1 -1.7,5.3 -4.6,5.3 -2.9,0 -4.6,-2.2 -4.6,-5.3 0,-3 1.7,-5.3 4.6,-5.3 z"/>

    <!-- body split -->
    <path
        android:pathData="M12,9.8 L12,19.2"
        android:strokeColor="#E53935"
        android:strokeWidth="0.9"/>

    <!-- legs -->
    <group android:strokeColor="#FFFFFF" android:strokeWidth="1.1" android:strokeLineCap="round">
        <path android:pathData="M8.7,10.6 L6.1,9.1"/>
        <path android:pathData="M8.4,12.7 L5.6,12.7"/>
        <path android:pathData="M8.7,14.8 L6.1,16.3"/>
        <path android:pathData="M15.3,10.6 L17.9,9.1"/>
        <path android:pathData="M15.6,12.7 L18.4,12.7"/>
        <path android:pathData="M15.3,14.8 L17.9,16.3"/>
    </group>

    <!-- antennae -->
    <group android:strokeColor="#FFFFFF" android:strokeWidth="1" android:strokeLineCap="round">
        <path android:pathData="M11,6.4 L9.8,4.6"/>
        <path android:pathData="M13,6.4 L14.2,4.6"/>
    </group>
</vector>
