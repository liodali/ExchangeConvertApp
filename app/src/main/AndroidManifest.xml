<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
<uses-permission android:name="android.permission.INTERNET"/>
    <!-- Local rate alerts (Account → Rate Alerts): posting notifications
         needs the runtime permission on Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application
        android:allowBackup="true"
        android:name=".ExchangeApplication"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.ExchangeCurrencyApp"
        >
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="stateHidden|adjustResize"
            android:theme="@style/Theme.ExchangeCurrencyApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- crash reporting: ExchangeApplication initialises the Sentry SDK
             programmatically (DSN from BuildConfig, empty = disabled) —
             the SDK's auto-init provider must stay off or it crashes at
             startup demanding a manifest DSN -->
        <meta-data
            android:name="io.sentry.auto-init"
            android:value="false" />

        <!-- Home-screen widgets (plans/widgets.md Phase 1) — two looks for
             the same market widget: circular wave (RxvJn sketch) and
             rounded card (prEnT sketch). Both share the config activity. -->
        <receiver
            android:name=".widgets.MarketRateWidgetReceiver"
            android:exported="false"
            android:label="@string/market_widget_wave_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/market_rate_widget_info" />
        </receiver>
        <receiver
            android:name=".widgets.MarketRateCardWidgetReceiver"
            android:exported="false"
            android:label="@string/market_widget_card_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/market_rate_card_widget_info" />
        </receiver>
        <receiver
            android:name=".widgets.MarketGridWidgetReceiver"
            android:exported="false"
            android:label="@string/market_grid_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/market_grid_widget_info" />
        </receiver>
        <receiver
            android:name=".widgets.QuickConvertWidgetReceiver"
            android:exported="false"
            android:label="@string/quick_convert_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_convert_widget_info" />
        </receiver>
        <activity
            android:name=".widgets.MarketRateWidgetConfigActivity"
            android:exported="true"
            android:label="@string/market_widget_config_label"
            android:theme="@style/Theme.ExchangeCurrencyApp.Sheet"
            android:windowSoftInputMode="adjustResize" />

        <!-- FCM — server-push rate alerts (plans/server-push-alerts.md).
             Data messages are rendered by SovereignMessagingService through
             the shared LocalNotifier; inert without google-services.json. -->
        <service
            android:name=".push.SovereignMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- system-trayed "notification" messages land on the alerts channel -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="rate_alerts" />
    </application>

</manifest>