<?xml version="1.0" encoding="utf-8"?>
<!-- Gold widget (plans/gold-section.md) — small 2x2, XAU base fixed,
     freely resizable like the market card -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="40dp"
    android:minHeight="40dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/market_rate_card_loading"
    android:configure="dali.hamza.echangecurrencyapp.widgets.MarketRateWidgetConfigActivity"
    android:previewLayout="@layout/gold_widget_preview"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
