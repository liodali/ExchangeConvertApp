<?xml version="1.0" encoding="utf-8"?>
<!-- Gold widget-picker preview (API 31+) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:gravity="center"
    android:orientation="vertical">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GOLD 24K"
        android:textColor="#E9C349"
        android:textSize="11sp"
        android:textStyle="bold" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="372.93 TND/g"
        android:textColor="#F4F4F6"
        android:textSize="20sp"
        android:textStyle="bold" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1 oz = 11,599.05"
        android:textColor="#8F9097"
        android:textSize="10sp" />
</LinearLayout>
