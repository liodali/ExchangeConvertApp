<?xml version="1.0" encoding="utf-8"?>
<!-- Staging builds share the release applicationId / Play app — the launcher
     badge, "(staging)" label, and -staging versionName identify the build. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background>
        <color android:color="@color/ic_launcher_background"/>
    </background>
    <foreground android:drawable="@drawable/ic_launcher_foreground_staging"/>
    <monochrome android:drawable="@drawable/ic_launcher_monochrome"/>
</adaptive-icon>
