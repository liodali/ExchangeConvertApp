// Shared Android and iOS app version. Edit only these two values.
// 0.15.0: gold widget release.
//  iOS PROD: tag ios-v0.15.0+97 (ASC highest was 94). Staging 93 verified
//       on-device; sentry-cocoa pinned exact 9.29.2 (KMP 0.29's version).
//  ANDROID PROD: app-v0.15.0+79 — Play's +1..3 guard requires the code to
//       sit next to Play's highest (78), so xcconfig flips to 79 for that
//       tag after the iOS tag is cut. The two tags validate against this
//       file sequentially, never simultaneously.
//  TestFlight build numbers follow the CI RUN number (93/94 observed),
//       not this value; this still feeds the archive + the ci_post guard.
// Keep xcconfig the single build-number source — Xcode Cloud's
// automatic build number stays OFF (ci_post_xcodebuild guard enforces).
MARKETING_VERSION = 0.15.0
CURRENT_PROJECT_VERSION = 97
