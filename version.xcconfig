// Shared Android and iOS app version. Edit only these two values.
// Increment CURRENT_PROJECT_VERSION before every new store upload.
// 0.15.0 (80): gold widget release build — NOT 0.15.1; the 0.15 line
// continues (never publicly released yet). Skip from 76 to 80 avoids
// build numbers consumed by the unfixed Xcode Cloud runs 76-79
// (crashing font-less builds). Keep xcconfig as the only build-number
// source — Xcode Cloud's automatic build number stays OFF.
MARKETING_VERSION = 0.15.0
CURRENT_PROJECT_VERSION = 80
