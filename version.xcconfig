// Shared Android and iOS app version. Edit only these two values.
// 0.16.0: metals v3 Option C — Home LIVE strip (silver/platinum/palladium)
//       + per-metal detail screen (selector chips, purity grid).
//  iOS STAGING: ios-v0.16.0-stg+100 (ASC highest 99) — metals page +
//       converter units + refresh fixes against backend v0.5.47-stg.
//  ANDROID STAGING: app-v0.16.0-stg+82 — Play +1..3 window (highest 81,
//       the 0.15.1 staging round). iOS cut at +100 (its run validates
//       against its own checkout, not live main).
//  iOS PROD: next tag ios-v0.16.0+NN — ASC highest is 99, so iOS builds
//       continue from 100 (xcconfig flips back after the Android tag,
//       the two tags validate against this file sequentially).
//  TestFlight build numbers follow the CI RUN number (93/94 observed),
//       not this value; this still feeds the archive + the ci_post guard.
// Keep xcconfig the single build-number source — Xcode Cloud's
// automatic build number stays OFF (ci_post_xcodebuild guard enforces).
MARKETING_VERSION = 0.16.0
CURRENT_PROJECT_VERSION = 100
